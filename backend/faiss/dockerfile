# -------- Stage 1: Build wheels --------
FROM python:3.11-slim-bullseye AS builder

ENV PYTHONUNBUFFERED=1
WORKDIR /wheels

# Build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        libopenblas-dev \
        liblapack-dev \
        build-essential \
        g++ \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Build all wheels locally
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt


# -------- Stage 2: Runtime image --------
FROM python:3.11-slim-bullseye

ENV PYTHONUNBUFFERED=1
WORKDIR /app

# Runtime dependencies (correct names for Bullseye)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libopenblas0 \
        liblapack3 \
    && rm -rf /var/lib/apt/lists/*

# Bring prebuilt wheels
COPY --from=builder /wheels /wheels
COPY requirements.txt /wheels/requirements.txt

RUN pip install --no-cache-dir --no-index --find-links=/wheels -r /wheels/requirements.txt


# -------- NEW: Pre-download FastEmbed model so startup is instant --------
RUN python3 - <<EOF
from fastembed import TextEmbedding
print("Downloading FastEmbed model...")
TextEmbedding("BAAI/bge-small-en-v1.5")
print("Model downloaded and cached!")
EOF


# Copy app
COPY . .

EXPOSE 8000

# Uvicorn command
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
